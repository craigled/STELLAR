;   4785   f6                    SHR
;   4786   bd                    PHI     R13                     ; q = h; DF = q was odd
;   4787   3b 9c                 BNF     EVEN
;   4789   88                    GLO     R8                      ; odd: y += i
;   478a   5f                    STR     R15
;   478b   2f                    DEC     R15
;   478c   98                    GHI     R8
;   478d   5f                    STR     R15
;   478e   1f                    INC     R15                     ; i into I1:I0
;   478f   ef                    SEX     R15
