;   4796   bb                    PHI     R11
;   4797   1f                    INC     R15
;   4798   8d                    GLO     R13
;   4799   7c 00                 ADCI    000H
;   479b   ad                    PLO     R13
;   479c   e2            EVEN:   SEX     R2                      ; y += h   (M(R2) is a scratch byte)
;   479d   9d                    GHI     R13
;   479e   52                    STR     R2
;   479f   8b                    GLO     R11
;   47a0   f4                    ADD
;   47a1   ab                    PLO     R11
;   47a2   9b                    GHI     R11
;   47a3   7c 00                 ADCI    000H
;   47a5   bb                    PHI     R11
;   47a6   8d                    GLO     R13
;   47a7   7c 00                 ADCI    000H
;   47a9   ad                    PLO     R13
;   47aa   89                    GLO     R9                      ; d into D1:D0
;   47ab   5e                    STR     R14
;   47ac   2e                    DEC     R14
;   47ad   99                    GHI     R9
;   47ae   5e                    STR     R14
;   47af   1e                    INC     R14
;   47b0   ee            DIV:    SEX     R14                     ; ---- x div d: subtract d until it borrows
;   47b1   8b            DSUB:   GLO     R11
;   47b2   f7                    SM
;   47b3   ab                    PLO     R11
;   47b4   2e                    DEC     R14
;   47b5   9b                    GHI     R11
