;   47db   98                    GHI     R8
;   47dc   3a 56                 BNZ     TERM
;
;                                ; a[1] = q mod 10, DIGIT = q div 10     (R7 -> a[0]; a[1] at R7+2)
;   47de   17                    INC     R7
;   47df   17                    INC     R7
