;   47d4   27                    DEC     R7                      ; R7 -> a[i-1]
;   47d5   29                    DEC     R9
;   47d6   29                    DEC     R9                      ; d -= 2
;   47d7   28                    DEC     R8                      ; i -= 1
;   47d8   88                    GLO     R8
