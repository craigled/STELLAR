;   47bd   3b c5                 BNF     DBACK                   ; borrowed: one too many
;   47bf   9d                    GHI     R13
;   47c0   fc 01                 ADI     001H
;   47c2   bd                    PHI     R13                     ; q += 1
;   47c3   30 b1                 BR      DSUB
;   47c5   8b            DBACK:  GLO     R11                     ; x += d: the remainder (< d, 16 bits)
;   47c6   f4                    ADD
;   47c7   ab                    PLO     R11
;   47c8   2e                    DEC     R14
;   47c9   9b                    GHI     R11
;   47ca   74                    ADC
;   47cb   bb                    PHI     R11
;   47cc   1e                    INC     R14
;   47cd   9b                    GHI     R11                     ; a[i] = the remainder
