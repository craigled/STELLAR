; D 41E4 10 00 00       LOADAI 0000
; D 41E7 09             GETEFA                             EF1-4 as a mask
; D 41E8 1A 08          TESTBITI 08                        EF4: the Input switch
; D 41EA A0 01 D1       IFTRUEI DL
; D 41ED 0A 00          SETQ 00                            key up
