; D 425A 81 00 00       TESTAI 0000
; D 425D A1 02 63       IFFALSEI LP
; D 4260 10 00 2A       LOADAI 002A
; LP:
; D 4263 C9             SEROUT
; D 4264 05 00          OUTA 00                            and on the hex display
; D 4266 BD 02 98       CALL KEEP                          and into the slot
; D 4269 42 08          INCX R8
; D 426B 11 05 00 01    LOADXI R5 0001
; D 426F 11 06 00 01    LOADXI R6 0001
; D 4273 BE 00          RETURN
; SPACE:
; D 4275 10 00 20       LOADAI 0020
; D 4278 BD 02 98       CALL KEEP                          a space in the slot: Lite-Writer wraps the words itself
; D 427B 11 06 00 00    LOADXI R6 0000
; D 427F 11 07 00 40    LOADXI R7 0040
; D 4283 89 87          TESTLXY R8 < R7
; D 4285 A1 02 8E       IFFALSEI SNL
; D 4288 CA 20          SEROUTI 20
; D 428A 42 08          INCX R8
; D 428C BE 00          RETURN
; SNL:
; D 428E 11 08 00 00    LOADXI R8 0000
; D 4292 CA 0D          SEROUTI 0D
; D 4294 CA 0A          SEROUTI 0A                         a new line (RE holds a gap average)
; D 4296 BE 00          RETURN
; KEEP:
; D 4298 2F 0B 0B 11    WRITEIDX R11 0B11
; D 429C 2E 0B 0B 10    READIDX R11 0B10
; D 42A0 81 00 00       TESTAI 0000
; D 42A3 A0 02 A9       IFTRUEI KP0                        not saving
; D 42A6 F1 4D E0       RUNMC 4DE0                         append it; the pool stays whole
; KP0:
; D 42A9 BE 00          RETURN

