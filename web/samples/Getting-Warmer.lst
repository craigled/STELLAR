; D 4069 11 0E 05 66    LOADXI R14 0566
; D 406D C1 0E          PRINTSTR R14
; D 406F 11 0C 0E 00    LOADXI R12 0E00
; D 4073 11 0D 0E 00    LOADXI R13 0E00
; D 4077 BD 01 C2       CALL GETL                          Read the line (echoed; backspace works; a lone ESC first quits)
; D 407A BD 02 69       CALL PARSE
; D 407D 8C 0D          TESTXZ R13
; D 407F A0 00 5B       IFTRUEI ASK                        an empty line: ask again
; D 4082 86 0D FF FF    TESTXI R13 FFFF
; D 4086 A0 01 11       IFTRUEI QUIT1                      Q: give up
; D 4089 86 0D FF FE    TESTXI R13 FFFE
; D 408D A1 00 99       IFFALSEI OKN
; BADN:
