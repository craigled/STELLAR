; D 409E 11 0C 03 E9    LOADXI R12 03E9
; D 40A2 89 AC          TESTLXY R10 < R12
; D 40A4 A1 00 90       IFFALSEI BADN                      nor over 1000
; D 40A7 23 00 A3       COPYXY R10 -> R3
; D 40AA 42 02          INCX R2                            a guess used
; D 40AC 87 31          TESTXY R3 = R1
; D 40AE A0 01 26       IFTRUEI WIN
; D 40B1 89 31          TESTLXY R3 < R1
; D 40B3 A1 00 C2       IFFALSEI HI
; D 40B6 51 13 05       SUBXYZ R1 - R3 -> R5               too low: distance = number - guess
