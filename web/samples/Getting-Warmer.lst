; D 4070 11 0E 05 82    LOADXI R14 0582
; D 4074 C1 0E          PRINTSTR R14
; D 4076 11 0C 0E 00    LOADXI R12 0E00
; D 407A 11 0D 0E 00    LOADXI R13 0E00
; D 407E BD 02 15       CALL GETL                          Read the line (echoed; backspace works; a lone ESC first quits)
; D 4081 BD 02 BC       CALL PARSE
; D 4084 8C 0D          TESTXZ R13
; D 4086 A0 00 62       IFTRUEI ASK                        an empty line: ask again
; D 4089 86 0D FF FF    TESTXI R13 FFFF
; D 408D A0 01 5B       IFTRUEI QUIT1                      Q: give up
; D 4090 86 0D FF FD    TESTXI R13 FFFD
; D 4094 A0 00 AA       IFTRUEI MUTE                       M: the sound off / on
; D 4097 86 0D FF FE    TESTXI R13 FFFE
