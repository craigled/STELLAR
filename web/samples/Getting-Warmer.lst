; D 40B1 A0 00 C4       IFTRUEI MON
; D 40B4 10 00 00       LOADAI 0000
; D 40B7 2F 0B 07 DD    WRITEIDX R11 07DD
; D 40BB 11 0E 06 EC    LOADXI R14 06EC
; D 40BF C1 0E          PRINTSTR R14
; D 40C1 B0 00 62       GAL ASK
; MON:
; D 40C4 10 00 01       LOADAI 0001
; D 40C7 2F 0B 07 DD    WRITEIDX R11 07DD
; D 40CB 11 0E 06 FB    LOADXI R14 06FB
; D 40CF C1 0E          PRINTSTR R14
; D 40D1 F1 48 12       RUNMC 4812
; D 40D4 B0 00 62       GAL ASK
; OKN:
; D 40D7 8C 0A          TESTXZ R10
