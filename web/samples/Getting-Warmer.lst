; D 40E3 11 0E 05 CD    LOADXI R14 05CD
; D 40E7 C1 0E          PRINTSTR R14
; D 40E9 B0 00 F2       GAL NWC
; WC3:
; D 40EC 11 0E 05 BB    LOADXI R14 05BB
; D 40F0 C1 0E          PRINTSTR R14
; NWC:
; D 40F2 23 00 54       COPYXY R5 -> R4                    this distance is the next one's "last"
; D 40F5 86 02 00 0A    TESTXI R2 000A
; D 40F9 A1 00 5B       IFFALSEI ASK
; D 40FC 11 0E 06 30    LOADXI R14 0630
; D 4100 C1 0E          PRINTSTR R14                       ten guesses and no luck
; D 4102 23 00 1A       COPYXY R1 -> R10
; D 4105 BD 02 17       CALL NUM
; D 4108 11 0E 06 6C    LOADXI R14 066C
; D 410C C1 0E          PRINTSTR R14
