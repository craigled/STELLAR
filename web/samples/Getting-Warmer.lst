; D 40DC 11 0C 03 E9    LOADXI R12 03E9
; D 40E0 89 AC          TESTLXY R10 < R12
; D 40E2 A1 00 9E       IFFALSEI BADN                      nor over 1000
; D 40E5 23 00 A3       COPYXY R10 -> R3
; D 40E8 42 02          INCX R2                            a guess used
; D 40EA 87 31          TESTXY R3 = R1
; D 40EC A0 01 73       IFTRUEI WIN
; D 40EF 89 31          TESTLXY R3 < R1
; D 40F1 A1 01 00       IFFALSEI HI
; D 40F4 51 13 05       SUBXYZ R1 - R3 -> R5               too low: distance = number - guess
; D 40F7 11 0E 05 AE    LOADXI R14 05AE
; D 40FB C1 0E          PRINTSTR R14
; D 40FD B0 01 09       GAL WC
; HI:
; D 4100 51 31 05       SUBXYZ R3 - R1 -> R5               too high: distance = guess - number
