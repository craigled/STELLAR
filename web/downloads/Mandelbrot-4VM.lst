; D 41CB 21 04          COPYAX Acc -> R4
; D 41CD 20 01          MEMMODE 01                         back to relative
; D 41CF 11 05 00 00    LOADXI R5 0000                     R5 = VMs still active
; D 41D3 86 01 00 01    TESTXI R1 0001
; D 41D7 A1 01 DC       IFFALSEI A1
; D 41DA 42 05          INCX R5
; A1:
; D 41DC 86 02 00 01    TESTXI R2 0001
