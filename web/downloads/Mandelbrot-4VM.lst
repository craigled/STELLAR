; D 41EC 42 05          INCX R5
; A3:
; D 41EE 86 04 00 01    TESTXI R4 0001
; D 41F2 A1 01 F7       IFFALSEI A4
; D 41F5 42 05          INCX R5
; A4:
; D 41F7 86 05 00 01    TESTXI R5 0001
; D 41FB A1 02 04       IFFALSEI NOTL                      others still drawing
; D 41FE 11 0E 06 26    LOADXI R14 0626
; D 4202 C1 0E          PRINTSTR R14                       We are the last: the cursor back
; NOTL:
; D 4204 C7 01          SETMULTI 01
; D 4206 00             HALT
; D 4207 F0 00 00       BREAK

