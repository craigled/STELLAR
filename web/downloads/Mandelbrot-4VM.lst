; D 419C A1 00 1F       IFFALSEI ROW
; D 419F C7 00          SETMULTI 00                        Nothing in between: check and print as one
; D 41A1 11 0E 06 0A    LOADXI R14 060A
; D 41A5 C1 0E          PRINTSTR R14
; D 41A7 20 00          MEMMODE 00                         ABSOLUTE addressing, to read the CIDP page
; D 41A9 11 09 2F 05    LOADXI R9 2F05
; D 41AD 35 01 09       COPYIMXA 1 byte M(R9) -> Acc       VM1 state (1 = active) - READIDX ignores ABSOLUTE
; D 41B0 21 01          COPYAX Acc -> R1
; D 41B2 11 09 2F 15    LOADXI R9 2F15
; D 41B6 35 01 09       COPYIMXA 1 byte M(R9) -> Acc       VM2 state (1 = active) - READIDX ignores ABSOLUTE
; D 41B9 21 02          COPYAX Acc -> R2
; D 41BB 11 09 2F 25    LOADXI R9 2F25
