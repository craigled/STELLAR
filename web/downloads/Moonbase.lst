; D 4022 A1 00 20       IFFALSEI SEED
; D 4025 CB             SERIN                              and swallow the key
; D 4026 11 04 00 34    LOADXI R4 0034                     CRLF
; D 402A BD 08 20       CALL SAY
; D 402D 11 04 00 34    LOADXI R4 0034                     CRLF
; D 4031 BD 08 20       CALL SAY
