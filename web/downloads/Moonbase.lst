; D 4053 11 0A 00 06    LOADXI R10 0006
; D 4057 BD 08 89       CALL RND
; D 405A 2E 09 12 60    READIDX R9 1260                    a random place for the FLASH
; D 405E 2F 0B 31 21    WRITEIDX R11 3121
