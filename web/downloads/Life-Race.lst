; D 41C3 21 07          COPYAX Acc -> R7
; D 41C5 22 07          COPYXA R7 -> Acc
; D 41C7 4E 00 30       ADDAI 0030
; D 41CA 2F 0E 0A 16    WRITEIDX R14 0A16
; D 41CE 11 0E 08 00    LOADXI R14 0800
; D 41D2 11 09 00 0A    LOADXI R9 000A
; SRs0:
; D 41D6 C1 0E          PRINTSTR R14                       One board row: ONE opcode, never cut
; D 41D8 52 0E 00 21    ADDXI R14 0021
; D 41DC 43 09          DECX R9
; D 41DE 8C 09          TESTXZ R9
; D 41E0 A1 01 D6       IFFALSEI SRs0
; D 41E3 11 0E 0A 00    LOADXI R14 0A00
; D 41E7 C1 0E          PRINTSTR R14                       The generation count
; D 41E9 86 01 00 08    TESTXI R1 0008
; D 41ED A0 02 FC       IFTRUEI END
; D 41F0 11 03 00 1B    LOADXI R3 001B                     The first interior cell
; D 41F4 11 04 00 08    LOADXI R4 0008                     row string: past the header
; D 41F8 11 09 00 33    LOADXI R9 0033                     end of the first row
; D 41FC 11 0A 00 0A    LOADXI R10 000A
