; D 42FC 11 0B 00 02    LOADXI R11 0002                    RB = 2: ask VM2 to stop (it looks every two generations)
; STOPW:
; D 4300 86 0C 00 01    TESTXI R12 0001
; D 4304 A1 03 00       IFFALSEI STOPW                     Wait until it has: its count is then in R5
; D 4307 11 0E 0F 19    LOADXI R14 0F19
; D 430B C1 0E          PRINTSTR R14
; D 430D 11 0E 0F 50    LOADXI R14 0F50
; D 4311 C1 0E          PRINTSTR R14
; D 4313 23 00 54       COPYXY R5 -> R4
; D 4316 BD 03 54       CALL PRNUM
; D 4319 11 0E 0F 61    LOADXI R14 0F61
; D 431D C1 0E          PRINTSTR R14
; D 431F 11 07 00 08    LOADXI R7 0008
; D 4323 4D 57          DIVXY R5 / R7                      VM2 / VM1
; D 4325 25             COPYMAA
; D 4326 21 04          COPYAX Acc -> R4
; D 4328 BD 03 54       CALL PRNUM
; D 432B 11 0E 0F 7A    LOADXI R14 0F7A
; D 432F C1 0E          PRINTSTR R14
; D 4331 00             HALT
; D 4332 F0 00 00       BREAK
; ESCCHK:
; D 4335 CC             SERST
; D 4336 A1 03 40       IFFALSEI ESCR
; D 4339 CB             SERIN
; D 433A 81 00 1B       TESTAI 001B
; D 433D A0 03 42       IFTRUEI QUIT
; ESCR:
; D 4340 BE 00          RETURN
; QUIT:
; D 4342 11 0B 00 02    LOADXI R11 0002                    RB = 2: VM2 halts itself (KILLVM would wreck its START byte)
; QUITW:
; D 4346 86 0C 00 01    TESTXI R12 0001
; D 434A A1 03 46       IFFALSEI QUITW                     Wait until it has
; D 434D 11 0E 0F 98    LOADXI R14 0F98
; D 4351 C1 0E          PRINTSTR R14
; D 4353 00             HALT                               Quit by ESC
; PRNUM:
; D 4354 11 08 00 00    LOADXI R8 0000
; PN1:
; D 4358 4D 4F          DIVXY R4 / R15
; D 435A 27             COPYREMA
; D 435B 70 00          PUSHA Acc                          digits onto the stack
; D 435D 42 08          INCX R8
; D 435F 25             COPYMAA
; D 4360 21 04          COPYAX Acc -> R4
; D 4362 8C 04          TESTXZ R4
; D 4364 A1 03 58       IFFALSEI PN1
; PN2:
; D 4367 71 00          POPA Acc
; D 4369 4E 00 30       ADDAI 0030
; D 436C C9             SEROUT
; D 436D 43 08          DECX R8
; D 436F 8C 08          TESTXZ R8
; D 4371 A1 03 67       IFFALSEI PN2
; D 4374 BE 00          RETURN

