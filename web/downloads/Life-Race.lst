; D 42DF C1 0E          PRINTSTR R14                       One board row: ONE opcode, never cut
; D 42E1 52 0E 00 21    ADDXI R14 0021
; D 42E5 43 09          DECX R9
; D 42E7 8C 09          TESTXZ R9
