; D 4240 86 08 00 04    TESTXI R8 0004
; D 4244 A1 02 62       IFFALSEI GD1                       not 3 or 4: dead
; D 4247 2E 03 0D 00    READIDX R3 0D00                    4: as it was
; D 424B 81 00 01       TESTAI 0001
; D 424E A1 02 62       IFFALSEI GD1
; GA1:
; D 4251 10 00 01       LOADAI 0001
; D 4254 2F 03 0B 00    WRITEIDX R3 0B00
