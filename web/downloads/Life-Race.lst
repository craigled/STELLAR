; D 418B 23 00 17       COPYXY R1 -> R7
; D 418E 11 0E 00 00    LOADXI R14 0000
; D 4192 11 08 03 E8    LOADXI R8 03E8
; D 4196 4D 78          DIVXY R7 / R8
; D 4198 25             COPYMAA
; D 4199 4E 00 30       ADDAI 0030
; D 419C 2F 0E 0A 13    WRITEIDX R14 0A13
