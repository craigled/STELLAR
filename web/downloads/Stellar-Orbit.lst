; ==========================================================================
; STELLAR ORBIT  -  Apollo 7 on the 1802  (2 programs, 1 file)
; ==========================================================================
; Load this ONE file - it is flight.lst and screen.lst in that order:
;   VM1 + VM2 ($4000-$5FFF, SETSIZE 2): the flight computer - keys, the clock (the
;     real-time clock x the warp), the physics in native 1802 code via RUNMC;
;   VM3 + VM4 ($6000-$7EFF, SETSIZE 2): the screen - the map, the rocket, the
;     flight-data panel, the event line, the help and the sound on Q.
; VM1 publishes a 64-byte STATE record at $5FC0; VM3 pauses itself until VM1 wakes
; it, and draws with multitasking off. VM1's work area is at $3600 (VM2's labels).
;
; The mission: SPACE starts the count. Climbing: E (inboard engine) before 4 g, T
; (the tower), C at the cut-off. In orbit: + / - set the de-orbit delta-v, B has
; Mission Control time the burn, then B again on the zero. Coming down: D the drogue
; chutes (under 160 m/s), M the mains (under 70 m/s). Score at the splash: 1000 less
; 4 a km from the recovery ship. < > warp, P pause, S sound, ? help, R again, Q quit.
; Each mission has 1 to 3 emergencies at random: a cabin leak or a fuel-cell failure
; (come home early), the SPS failing to ignite (B again) - and maybe head colds.
; Left of the Earth, the rocket: its stages drop away as they separate, down to the
; capsule, which falls to the water on its chutes.
;
; VT100 terminal; needs the Elf2K's real-time clock (DS12887). V0061.36 firmware.
; Built from APPLICATIONS/Stellar-Orbit (build_all.py); the memory map is in MEMORY-MAP.md there.
; Verifier: Firmware-Math/orbit_verify.py (every engine step against flight_model.py).
;
; ==========================================================================
; VM1's tables load at $7D9B-$7EFF, at the top of VM3's 8 KB below W: SINQ $7D9B, S64 $7E51, PITCH $7E92, STG $7EA3, MANT $7EC7, WLEV $7EE7, RANGES $7EF7.
; flight  -  compiled from flight.sc by scc (Stellar C, prototype)   loads at $4000-$5FFF
; ==========================================================================
; 78 STELLAR commands, 225 bytes of code, 7860 bytes of data.
; registers: cmd R0, el R1, lastsec R2, polls R3, engine.c R4
; in memory: nothing
;
; DISASSEMBLY  -  commented out; the loader skips it
;
; D 4000 CD             START                          Stellar C: flight
; D 4001 F2 02          SETSIZE 02                     the program needs 8 KB
; D 4003 11 0C 00 00    LOADXI R12 0000                // STELLAR ORBIT - VM1, the flight computer. GENERATED by bu   RC = 0: the index for a[k] and the u8 variables
; D 4007 11 0E 00 F0    LOADXI R14 00F0                u8 t[8];
; D 400B 11 0F 00 F7    LOADXI R15 00F7
; D 400F FB EF 00       FILLMEMXY RE..RF 00
; D 4012 BD 00 1E       CALL F_main                    run main()
; QUIT:
; D 4015 00             HALT
; engine():
; D 4016 23 00 40       COPYXY R4 -> R0                cmd = c;
; D 4019 F1 40 F8       RUNMC 40F8                     SEX R2   native block, 7860 bytes
; D 401C BE 00          RETURN
; main():
; D 401E 11 0F 36 97    LOADXI R15 3697                poke(WADDR + SND, 1);                // the sound on (S turn
; D 4022 10 00 01       LOADAI 0001
; D 4025 20 00          MEMMODE 00                     absolute - no branch
; D 4027 2F 0F 00 00    WRITEIDX R15 0000
; D 402B 20 01          MEMMODE 01                     relative again
; D 402D 11 04 00 07    LOADXI R4 0007                 engine(7);
; D 4031 BD 00 16       CALL F_engine
; D 4034 CC             SERST                          if (keyready()) {
; D 4035 A1 00 66       IFFALSEI L6
; D 4038 11 0F 36 81    LOADXI R15 3681                poke(WADDR + KEY, getc()); engine(9);
; D 403C CB             SERIN
; D 403D 20 00          MEMMODE 00                     absolute - no branch
; D 403F 2F 0F 00 00    WRITEIDX R15 0000
; D 4043 20 01          MEMMODE 01                     relative again
; D 4045 11 04 00 09    LOADXI R4 0009
; D 4049 BD 00 16       CALL F_engine
; D 404C 11 0E 36 74    LOADXI R14 3674                if (peek(WADDR + PH) == P_QUIT) { delay(250); halt(); }
; D 4050 20 00          MEMMODE 00                     absolute - no branch
; D 4052 2E 0E 00 00    READIDX R14 0000
; D 4056 20 01          MEMMODE 01                     relative again
; D 4058 21 0F          COPYAX Acc -> R15
; D 405A 86 0F 00 09    TESTXI R15 0009
; D 405E A1 00 66       IFFALSEI L8
; D 4061 C0 FA          DLYI FA
; D 4063 B0 00 15       GAL QUIT
; D 4066 42 03          INCX R3                        polls = polls + 1;                   // the clock every 8th
; D 4068 11 0F 00 08    LOADXI R15 0008                if (polls < 8) continue;             // instructions, and th
; D 406C 89 3F          TESTLXY R3 < R15
; D 406E A0 00 D9       IFTRUEI L4
; D 4071 11 03 00 00    LOADXI R3 0000                 polls = 0;
; D 4075 11 0F 00 F0    LOADXI R15 00F0                rtcget(t);
; D 4079 07 0F          RTCGET R15                     sec min hour wday day month yearhi yearlo
; D 407B 2E 0C 00 F0    READIDX R12 00F0               if (t[0] != lastsec) {
; D 407F 21 0F          COPYAX Acc -> R15
; D 4081 87 F2          TESTXY R15 = R2
; D 4083 A0 00 D9       IFTRUEI L10
; D 4086 2E 0C 00 F0    READIDX R12 00F0               el = t[0] - lastsec;
; D 408A 21 0F          COPYAX Acc -> R15
; D 408C 51 F2 01       SUBXYZ R15 - R2 -> R1
; D 408F 2E 0C 00 F0    READIDX R12 00F0               if (t[0] < lastsec) el += 60;
; D 4093 21 0F          COPYAX Acc -> R15
; D 4095 89 F2          TESTLXY R15 < R2
; D 4097 A1 00 9E       IFFALSEI L12
; D 409A 52 01 00 3C    ADDXI R1 003C
; D 409E 11 0F 00 03    LOADXI R15 0003                if (el > 3) el = 3;              // after a pause or a long
; D 40A2 89 F1          TESTLXY R15 < R1
; D 40A4 A1 00 AB       IFFALSEI L14
; D 40A7 11 01 00 03    LOADXI R1 0003
; D 40AB 2E 0C 00 F0    READIDX R12 00F0               lastsec = t[0];
; D 40AF 21 02          COPYAX Acc -> R2
; D 40B1 11 0E 36 79    LOADXI R14 3679                if (!peek(WADDR + PAUSE)) { poke(WADDR + EL, el); engine(8);
; D 40B5 20 00          MEMMODE 00                     absolute - no branch
; D 40B7 2E 0E 00 00    READIDX R14 0000
; D 40BB 20 01          MEMMODE 01                     relative again
; D 40BD 21 0F          COPYAX Acc -> R15
; D 40BF 8C 0F          TESTXZ R15
; D 40C1 A1 00 D9       IFFALSEI L16
; D 40C4 11 0F 36 7E    LOADXI R15 367E
; D 40C8 22 01          COPYXA R1 -> Acc
; D 40CA 20 00          MEMMODE 00                     absolute - no branch
; D 40CC 2F 0F 00 00    WRITEIDX R15 0000
; D 40D0 20 01          MEMMODE 01                     relative again
; D 40D2 11 04 00 08    LOADXI R4 0008
; D 40D6 BD 00 16       CALL F_engine
; D 40D9 B0 00 34       GAL L1                         while (1) {
; D 40DC BE 00          RETURN
; D 40DE F0 00 00       BREAK                          end marker: the pre-pass stops here
