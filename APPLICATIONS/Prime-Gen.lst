D 4220 87 B3 88 8C 04 A3 B7 8C 07 A2 B8 B3 B7 22 04 4E
D 4230 00 30 C9 10 00 01 21 07 B3 B8 22 03 4E 00 30 C9
D 4240 BE 00

; ---- STRINGS ($4700..$4747) ----
;   $4700 "STELLAR Prime Generator\r\n"
;   $471A "Low limit:  "
;   $4727 "High limit: "
;   $4734 "Primes:\r\n"
;   $473E "\r\nDone.\r\n"

; ---- pre-pass END marker (v03): without it the pre-pass scanned
;      dirty RAM past PRINT and corrupted the loop labels ----
D 4242 F0 00 00

D 4700 53 54 45 4C 4C 41 52 20 50 72 69 6D 65 20 47 65
D 4710 6E 65 72 61 74 6F 72 0D 0A 00 4C 6F 77 20 6C 69
D 4720 6D 69 74 3A 20 20 00 48 69 67 68 20 6C 69 6D 69
