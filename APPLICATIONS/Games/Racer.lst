; D 404C 11 09 0F 40    LOADXI R9 0F40
; D 4050 11 0A 0F 7F    LOADXI R10 0F7F
; D 4054 FB 9A 00       FILLMEMXY R9..RA 00                and had no rocks
; D 4057 11 0C 00 18    LOADXI R12 0018
