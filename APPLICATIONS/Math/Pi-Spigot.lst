; --------------------------------------------------------------------------
; NATIVE CODE  -  a18 listing of Firmware-Math/pi_native.asm (commented out)
; --------------------------------------------------------------------------
;                                CPU     1802
;                        ; ==========================================================================
;                        ;  PI BY THE SPIGOT - one pass of the spigot, in raw 1802, called by $F1 RUNMC
;                        ; ==========================================================================
;                        ;  The bytecode version spends ~4,350 1802 instructions on each array term
;                        ;  (16 STELLAR opcodes, mostly dispatch and SCRT). Here a term is ~170.
;                        ;
;                        ;  TWO ENTRIES (absolute addresses - RUNMC operands are not program-relative):
;                        ;    INIT  $4700   a[1..L] = 2              L = the word at LW
;                        ;    PASS  $4730   one pass from i = TOP down to 1:
;                        ;                      x = 10 a[i] + q i;  a[i] = x mod (2i-1);  q = x div (2i-1)
;                        ;                  then a[1] = q mod 10 and DIGIT = q div 10
;                        ;
;                        ;  THE ARRAY: a[i] is a big-endian word at ARR + 2i. ARR is even, so every
;                        ;  high byte is at an even address - and $5000 and $6000 (the first bytes of
;                        ;  the VM2 and VM3 blocks this program borrows with SETSIZE 3) only ever hold a
;                        ;  HIGH byte. a[i] < 2i - 1 < 10000, so that byte is never $CD (START): a cold
;                        ;  boot can never mistake stale array data for a VM2/VM3 program.
;                        ;
;                        ;  ARITHMETIC: x is 24 bits (RD.0 : RB) - past ~480 digits 10 a + q i passes
;                        ;  65535. q is always < 128 (measured: at most 103 for up to 1500 digits).
;                        ;  NO MULTIPLY: d = 2i - 1, so q i = (q div 2) d + (q div 2) + (i if q is odd),
;                        ;  and the division only has to count y = 10 a + (q div 2) [+ i] in d's - at
;                        ;  most about 11, on average about 5 - starting from q div 2.
;                        ;
;                        ;  CALLING CONVENTION (the RUNMC handler at $2600, see gol_native.asm):
;                        ;    P = R3; R6 is the way home; return with D5. R2, R7-R9, RB, RD-RF are
;                        ;    saved and restored by the handler; RA is avoided. X is not preserved:
;                        ;    SEX R2 before returning.
;                        ;
;                        ;  REGISTERS:  R7 -> a[i] (its high byte)   R8 i   R9 d = 2i - 1
;                        ;              RB x low 16                   RD.0 x high byte   RD.1 q
;                        ;              RE -> D0 (d in memory)        RF -> I0 (i in memory)
;                        ; ==========================================================================
;
;   4810                 ARR     EQU     SCR+16          ; a[i] at ARR + 2i (a[0] unused)
;
;                        ; --------------------------------------------------------------------------
;                        ;  INIT: a[1..L] = 2.     RUNMC $4700
;                        ; --------------------------------------------------------------------------
;   4700                         ORG     04700H
;   4700   f8 48         INIT:   LDI     HIGH LWH
;   4702   bf                    PHI     R15
;   4703   f8 06                 LDI     LOW LWH
;   4705   af                    PLO     R15
;   4706   4f                    LDA     R15
;   4707   b8                    PHI     R8
;   4708   0f                    LDN     R15
;   4709   a8                    PLO     R8                      ; R8 = L
;   470a   f8 48                 LDI     HIGH (ARR+2)
;   470c   b7                    PHI     R7
;   470d   f8 12                 LDI     LOW (ARR+2)
;   470f   a7                    PLO     R7                      ; R7 -> a[1]
;   4710   f8 00         FILL:   LDI     000H
;   4712   57                    STR     R7
;   4713   17                    INC     R7
;   4714   f8 02                 LDI     002H
;   4716   57                    STR     R7
;   4717   17                    INC     R7
;   4718   28                    DEC     R8
;   4719   88                    GLO     R8
;   471a   3a 10                 BNZ     FILL
;   471c   98                    GHI     R8
;   471d   3a 10                 BNZ     FILL
;   471f   e2                    SEX     R2
;   4720   d5                    DB      0D5H                    ; RETURN
;
;                        ; --------------------------------------------------------------------------
;                        ;  PASS.     RUNMC $4730
;                        ; --------------------------------------------------------------------------
;   4730                         ORG     04730H
;   4730   f8 48         PASS:   LDI     HIGH TOPH
;   4732   bf                    PHI     R15
;   4733   f8 04                 LDI     LOW TOPH
;   4735   af                    PLO     R15
;   4736   4f                    LDA     R15
;   4737   b8                    PHI     R8
;   4738   0f                    LDN     R15
;   4739   a8                    PLO     R8                      ; R8 = i = TOP
;   473a   88                    GLO     R8
;   473b   fe                    SHL
;   473c   a9                    PLO     R9
;   473d   98                    GHI     R8
;   473e   7e                    SHLC
;   473f   b9                    PHI     R9                      ; R9 = 2i
;   4740   89                    GLO     R9
;   4741   fc 10                 ADI     LOW ARR
;   4743   a7                    PLO     R7
;   4744   99                    GHI     R9
;   4745   7c 48                 ADCI    HIGH ARR
;   4747   b7                    PHI     R7                      ; R7 = ARR + 2i -> a[i]
;   4748   29                    DEC     R9                      ; R9 = d = 2i - 1
;   4749   f8 48                 LDI     HIGH I0
;   474b   bf                    PHI     R15
;   474c   be                    PHI     R14
;   474d   f8 01                 LDI     LOW I0
;   474f   af                    PLO     R15                     ; RF -> I0
;   4750   f8 03                 LDI     LOW D0
;   4752   ae                    PLO     R14                     ; RE -> D0
;   4753   f8 00                 LDI     000H
;   4755   bd                    PHI     R13                     ; q = 0
;
;   4756   47            TERM:   LDA     R7
;   4757   bb                    PHI     R11
;   4758   07                    LDN     R7
;   4759   ab                    PLO     R11                     ; x = a[i]   (R7 -> its low byte)
;   475a   f8 00                 LDI     000H
;   475c   ad                    PLO     R13
;   475d   8b                    GLO     R11                     ; x <<= 2: 4a
;   475e   fe                    SHL
;   475f   ab                    PLO     R11
;   4760   9b                    GHI     R11
;   4761   7e                    SHLC
;   4762   bb                    PHI     R11
;   4763   8d                    GLO     R13
;   4764   7e                    SHLC
;   4765   ad                    PLO     R13
;   4766   8b                    GLO     R11
;   4767   fe                    SHL
;   4768   ab                    PLO     R11
;   4769   9b                    GHI     R11
;   476a   7e                    SHLC
;   476b   bb                    PHI     R11
;   476c   8d                    GLO     R13
;   476d   7e                    SHLC
;   476e   ad                    PLO     R13
;   476f   e7                    SEX     R7                      ; x += a: 5a   (a is still at R7)
;   4770   8b                    GLO     R11
;   4771   f4                    ADD
;   4772   ab                    PLO     R11
;   4773   27                    DEC     R7                      ; R7 -> the high byte again
;   4774   9b                    GHI     R11
;   4775   74                    ADC
;   4776   bb                    PHI     R11
;   4777   8d                    GLO     R13
;   4778   7c 00                 ADCI    000H
;   477a   ad                    PLO     R13
;   477b   8b                    GLO     R11                     ; x <<= 1: 10a
;   477c   fe                    SHL
;   477d   ab                    PLO     R11
;   477e   9b                    GHI     R11
;   477f   7e                    SHLC
;   4780   bb                    PHI     R11
;   4781   8d                    GLO     R13
;   4782   7e                    SHLC
;   4783   ad                    PLO     R13
;                                ; ---- x += q i, with no multiply. d = 2i - 1, so with h = q div 2:
;                                ;   q i = h d + h + (i if q is odd)
;                                ; and x div d = h + y div d, x mod d = y mod d, where
;                                ;   y = 10 a + h + (i if q is odd)          (y < 12 d: a short count)
;   4784   9d                    GHI     R13
;   4785   f6                    SHR
;   4786   bd                    PHI     R13                     ; q = h; DF = q was odd
;   4787   3b 9c                 BNF     EVEN
;   4789   88                    GLO     R8                      ; odd: y += i
;   478a   5f                    STR     R15
;   478b   2f                    DEC     R15
;   478c   98                    GHI     R8
;   478d   5f                    STR     R15
;   478e   1f                    INC     R15                     ; i into I1:I0
;   478f   ef                    SEX     R15
;   4790   8b                    GLO     R11
;   4791   f4                    ADD
;   4792   ab                    PLO     R11
;   4793   2f                    DEC     R15
;   4794   9b                    GHI     R11
;   4795   74                    ADC
;   4796   bb                    PHI     R11
;   4797   1f                    INC     R15
;   4798   8d                    GLO     R13
;   4799   7c 00                 ADCI    000H
;   479b   ad                    PLO     R13
;   479c   e2            EVEN:   SEX     R2                      ; y += h   (M(R2) is a scratch byte)
;   479d   9d                    GHI     R13
;   479e   52                    STR     R2
;   479f   8b                    GLO     R11
;   47a0   f4                    ADD
;   47a1   ab                    PLO     R11
;   47a2   9b                    GHI     R11
;   47a3   7c 00                 ADCI    000H
;   47a5   bb                    PHI     R11
;   47a6   8d                    GLO     R13
;   47a7   7c 00                 ADCI    000H
;   47a9   ad                    PLO     R13
;   47aa   89                    GLO     R9                      ; d into D1:D0
;   47ab   5e                    STR     R14
;   47ac   2e                    DEC     R14
;   47ad   99                    GHI     R9
;   47ae   5e                    STR     R14
;   47af   1e                    INC     R14
;   47b0   ee            DIV:    SEX     R14                     ; ---- x div d: subtract d until it borrows
;   47b1   8b            DSUB:   GLO     R11
;   47b2   f7                    SM
;   47b3   ab                    PLO     R11
;   47b4   2e                    DEC     R14
;   47b5   9b                    GHI     R11
;   47b6   77                    SMB
;   47b7   bb                    PHI     R11
;   47b8   1e                    INC     R14
;   47b9   8d                    GLO     R13
;   47ba   7f 00                 SMBI    000H
;   47bc   ad                    PLO     R13
;   47bd   3b c5                 BNF     DBACK                   ; borrowed: one too many
