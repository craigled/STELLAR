; D 4239 8C 0E          TESTXZ R14
; D 423B A0 02 88       IFTRUEI PR                         end of the line
; D 423E 86 0E 00 20    TESTXI R14 0020
; D 4242 A1 02 4F       IFFALSEI PDG
; D 4245 42 0C          INCX R12
; D 4247 8C 0D          TESTXZ R13
; D 4249 A0 02 33       IFTRUEI PS                         spaces before the number
; D 424C B0 02 6D       GAL PT
; PDG:
; D 424F 53 0E 00 30    SUBXI R14 0030
