; PARSE:
; D 4227 11 0A 00 00    LOADXI R10 0000
; D 422B 11 0C 00 00    LOADXI R12 0000
; D 422F 11 0D 00 00    LOADXI R13 0000
; PS:
; D 4233 2E 0C 06 5E    READIDX R12 065E
