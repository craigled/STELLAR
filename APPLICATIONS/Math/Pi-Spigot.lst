; D 4215 86 0C 00 03    TESTXI R12 0003
; D 4219 A1 02 09       IFFALSEI NZ                        (the last digit always prints)
; NP:
; D 421C 11 0E 06 58    LOADXI R14 0658
; D 4220 50 EC 0E       ADDXYZ R14 + R12 -> R14
