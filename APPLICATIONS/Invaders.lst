; D 41A2 B0 02 04       GAL BOMBDONE
; D 41A5 C3             RAND                   Roughly one frame in twenty-four starts a bomb
; D 41A6 21 09          COPYAX 09
; D 41A8 11 0A 00 18    LOADXI R10 0018
; D 41AC 4D 9A          DIVXY R9 R10
; D 41AE 27             COPYREMA
; D 41AF 81 00 00       TESTAI 0000
; D 41B2 A1 02 04       IFFALSEI BOMBDONE      Not this time
; D 41B5 C3             RAND                   Pick one of the twelve ships at random
; D 41B6 21 09          COPYAX 09
; D 41B8 11 0A 00 0C    LOADXI R10 000C
; D 41BC 4D 9A          DIVXY R9 R10
; D 41BE 27             COPYREMA               0 to 11
; D 41BF 21 09          COPYAX 09
; D 41C1 2E 09 09 60    READIDX R9 0960        Is that one still flying?
; D 41C5 81 00 00       TESTAI 0000
; D 41C8 A0 02 04       IFTRUEI BOMBDONE       Destroyed - no bomb this time
; D 41CB 11 0A 00 06    LOADXI R10 0006
; D 41CF 4D 9A          DIVXY R9 R10           Split the index into row and place
