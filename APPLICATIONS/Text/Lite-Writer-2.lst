; D 4256 11 09 00 48    LOADXI R9 0048
; D 425A 89 89          TESTLXY R8 < R9
; D 425C A1 02 71       IFFALSEI PR_WRAP                   at the margin: wrap
; D 425F BD 09 59       CALL SYNCIF
; D 4262 BD 09 83       CALL INSCHAR
; D 4265 23 00 DA       COPYXY R13 -> R10
; D 4268 BD 08 84       CALL N_C                           type: one byte out
