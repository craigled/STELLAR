; PR_WRAP:
; D 4271 86 0D 00 20    TESTXI R13 0020
; D 4275 A0 02 F7       IFTRUEI K_ENTER                    a space at the margin is a new line
; D 4278 BD 08 D2       CALL N_P                           RA = the last space on this line
; D 427B 8C 0A          TESTXZ R10
; D 427D A0 02 B0       IFTRUEI PR_HARD
; D 4280 87 A5          TESTXY R10 = R5
; D 4282 A0 02 B0       IFTRUEI PR_HARD                    (not one at the very start)
; D 4285 23 00 A7       COPYXY R10 -> R7
; D 4288 10 00 0D       LOADAI 000D
; D 428B 2F 07 00 00    WRITEIDX R7 0000                   that space becomes the new line
; D 428F 51 34 0A       SUBXYZ R3 - R4 -> R10
; D 4292 42 0A          INCX R10
; D 4294 51 75 0C       SUBXYZ R7 - R5 -> R12
; D 4297 42 0C          INCX R12
; D 4299 BD 08 90       CALL N_G
; D 429C 11 0E 15 EC    LOADXI R14 15EC                    erase the word from this line
; D 42A0 BD 08 7E       CALL N_S
; D 42A3 42 03          INCX R3
; D 42A5 23 00 75       COPYXY R7 -> R5
; D 42A8 42 05          INCX R5                            the new line starts after it
; D 42AA BD 09 83       CALL INSCHAR
; D 42AD B0 02 C1       GAL NEWROW
; PR_HARD:
; D 42B0 10 00 0D       LOADAI 000D
; D 42B3 2F 01 00 00    WRITEIDX R1 0000                   no space: break the word here
; D 42B7 42 01          INCX R1
; D 42B9 42 03          INCX R3
; D 42BB 23 00 15       COPYXY R1 -> R5
; D 42BE BD 09 83       CALL INSCHAR
; NEWROW:
; D 42C1 10 00 01       LOADAI 0001
; D 42C4 2F 0B 1F A0    WRITEIDX R11 1FA0                  MOD := 1
; D 42C8 51 15 06       SUBXYZ R1 - R5 -> R6               the column Up/Down aim for
; D 42CB 51 34 0A       SUBXYZ R3 - R4 -> R10
; D 42CE 42 0A          INCX R10
; D 42D0 11 08 00 18    LOADXI R8 0018
; D 42D4 89 A8          TESTLXY R10 < R8
