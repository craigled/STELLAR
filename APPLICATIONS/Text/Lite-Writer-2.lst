; D 4127 86 0A 00 06    TESTXI R10 0006
; D 412B A0 05 D7       IFTRUEI K_FIND
; D 412E 86 0A 00 13    TESTXI R10 0013
; D 4132 A0 06 64       IFTRUEI K_SAVE
; D 4135 86 0A 00 0C    TESTXI R10 000C
; D 4139 A0 06 D2       IFTRUEI K_LOAD
; D 413C 86 0A 00 0E    TESTXI R10 000E
; D 4140 A0 07 82       IFTRUEI K_NEW
; D 4143 86 0A 00 16    TESTXI R10 0016
; D 4147 A0 07 90       IFTRUEI K_REDRAW
; D 414A 86 0A 00 07    TESTXI R10 0007
