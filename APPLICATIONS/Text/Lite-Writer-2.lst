; D 423A BD 09 83       CALL INSCHAR
; D 423D 23 00 DA       COPYXY R13 -> R10
; D 4240 BD 08 84       CALL N_C                           the character
; D 4243 23 00 2A       COPYXY R2 -> R10
; D 4246 BD 08 A2       CALL N_L                           and the rest of the line after it
; D 4249 10 00 01       LOADAI 0001
; D 424C 2F 0B 1F A3    WRITEIDX R11 1FA3                  CDIRTY := 1
; D 4250 51 15 06       SUBXYZ R1 - R5 -> R6               the column Up/Down aim for
; D 4253 B0 00 5B       GAL MAIN
